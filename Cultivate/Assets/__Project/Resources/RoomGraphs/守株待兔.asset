    elementName: 
    connections: []
    rect:
      serializedVersion: 2
      x: 694.1
      y: 1043.5
      width: 16
      height: 16
    defaultValue: "\u4F60\u53EB\u9192\u4E86\u90A3\u4EBA\uFF0C\u90A3\u4EBA\u60CA\u53F9\u9053\uFF1A\u539F\u6765\u7B97\u547D\u7684\u8BF4\u7684\u662F\u771F\u7684\uFF01\u4F60\u89E3\u91CA\u5230\u662F\u4F60\u4EEC\u7684\u8FD0\u6C14\u597D\u3002\"
      +\r\n                                          \"\\n\\n\u4ED6\u6FC0\u52A8\u5730\u8BF4\u9053\uFF0C\u4E4B\u524D\u6709\u4E00\u4E2A\u7B97\u547D\u7684\u4EBA\u548C\u4ED6\u8BF4\uFF0C\u8FD9\u91CC\u4ECE\u6765\u6CA1\u6709\u5154\u5B50\u4E5F\u7B49\u4E0D\u6765\u5154\u5B50\uFF0C\u4F46\u4F1A\u6709\u8D35\u4EBA\u7ECF\u8FC7\uFF0C\u8D35\u4EBA\u4F1A\u5B89\u6392\u597D\u5154\u5B50\u540E\uFF0C\u5047\u88C5\u5154\u5B50\u662F\u649E\u6B7B\u7684\u3002\"
      +\r\n                                          \"\\n\\n\u4ED6\u5F53\u65F6\u8FD8\u4E0D\u4FE1\uFF0C\u539F\u6765\u771F\u7684\u53EF\u4EE5\u7B49\u6765\u5154\u5B50\uFF0C\u54E6\u4E0D\uFF0C\u8D35\u4EBA\u3002\"
      +\r\n                                          $\"\\n\\n\u7136\u540E\u9080\u8BF7\u4F60\u5230\u5E9C\u4E0A\u505A\u5BA2\uFF0C\u5411\u4F60\u95EE\u4E86\u4E00\u4E9B\u95EE\u9898\u3002\u8FD8\u8D60\u9001\u4E86\u4F60\u4E00\u4E9B\u94B1\u3002\n\u83B7\u5F97\u4E00\u4E9B\u91D1\u94B1"
